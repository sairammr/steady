{
  "name": "steady",
  "version": "0.1.0",
  "private": true,
  "description": "STEADY: your breathing moves the crosshair. Fire in your natural respiratory pause, measured live by your webcam (Presage SmartSpectra).",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "scripts/launch.sh app",
    "spike": "scripts/launch.sh spike",
    "spike:summary": "node --experimental-strip-types --no-warnings src/cli/spike-summary.ts",
    "replay": "node --experimental-strip-types --no-warnings src/cli/replay.ts",
    "plot": "node --experimental-strip-types --no-warnings scripts/plot-recording.ts",
    "fixtures": "node --experimental-strip-types --no-warnings scripts/gen-fixtures.ts",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "start:inline": "npm run build && electron ."
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "~3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "43.8.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3"
  }
}
